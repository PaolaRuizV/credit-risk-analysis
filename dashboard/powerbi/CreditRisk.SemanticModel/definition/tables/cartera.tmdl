				    Tipos = Table.TransformColumnTypes(Encabezados, {{"id_cliente", Int64.Type}, {"SeriousDlqin2yrs", Int64.Type}, {"utilizacion_credito", type number}, {"edad", Int64.Type}, {"atrasos_30_59", Int64.Type}, {"ratio_deuda", type number}, {"ingreso_mensual", type number}, {"lineas_credito_abiertas", Int64.Type}, {"atrasos_90_mas", Int64.Type}, {"prestamos_inmobiliarios", Int64.Type}, {"atrasos_60_89", Int64.Type}, {"dependientes", type number}, {"rango_edad", type text}, {"rango_atrasos_30_59", type text}, {"rango_atrasos_90_mas", type text}, {"tramo_utilizacion", type text}, {"orden_tramo_utilizacion", Int64.Type}, {"ingreso_faltante", Int64.Type}, {"estado_ingreso", type text}, {"grupo_dependientes", type text}, {"estado_mora", type text}}, "en-US")
				in
				    Tipos

